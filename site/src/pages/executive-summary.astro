---
import Base from '../layouts/Base.astro';
import { route } from '../lib/url';

const findings = [
  {
    group: 'What is true of the market',
    items: [
      {
        claim: 'No product dominated every workflow.',
        evidence:
          'Vivideo produced the most complete AGENT-01 first run; InVideo preserved the I2V scene best; HeyGen led guided planning and avatars; Pollo led model breadth; Revid connected social creation to publishing; Runway offered the deepest creative workflows.',
        so: 'The useful comparison is which product mechanism wins a job, not a single winner table.',
        prov: 'observed',
      },
      {
        claim: 'Credit confusion and paying to correct failure recur across the category.',
        evidence:
          'The selected review sample mentions credits spent on unfinished, stuck, regenerated or unusable output across all six products; late preview, export, resolution and watermark restrictions add to the uncertainty.',
        so: 'Users accept probabilistic output more readily than unpredictable cost and repeated payment for correction.',
        prov: 'claim',
      },
    ],
  },
  {
    group: 'What Vivideo testing showed, first-hand',
    items: [
      {
        claim: 'Vivideo already has credible end-to-end agent potential.',
        evidence:
          'Its AGENT-01 educational short was the most complete first-run result of the six, and the corrected avatar workflow produced a complete presenter video.',
        so: 'The strategic gap is not the absence of generation capability. It is the control and recovery layer around that capability.',
        prov: 'observed',
      },
      {
        claim: 'Cost and plan estimates were not consistently predictable.',
        evidence:
          'An estimate of 9 credits charged 15. A plan approved at 12 charged 21. A plan preview of 18 seconds delivered 34. A separate 6-credit estimate charged exactly 6 — the estimates are not consistently inflated, they are unreliable.',
        so: 'Duration drift is one symptom inside a broader predictability problem. The opportunity is a clear ceiling and visible settings, not merely better timing.',
        prov: 'observed',
      },
      {
        claim: 'An imperfect output is difficult to recover without starting over.',
        evidence:
          'The tested Vivideo build exposed no post-generation correction layer. T2V-01 added prohibited narration, while every I2V-01 output exceeded the requested approximately one full clockwise pinwheel turn.',
        so: 'Without scene-level correction, a constraint failure becomes another full generation, another wait and potentially another charge.',
        prov: 'observed',
      },
      {
        claim: 'The self-service cancellation journey does not finish inside the product.',
        evidence:
          'The flow shows what will be lost, asks for a reason, offers 50 bonus credits — then instructs the user to email support. Pollo completed cancellation in three clicks.',
        so: 'It adds support dependency at the highest-friction moment in the customer relationship.',
        prov: 'observed',
      },
    ],
  },
  {
    group: 'What is worth taking from competitors',
    items: [
      {
        claim: 'Pollo rewards both signup and paid conversion.',
        evidence:
          'Both sides receive 50 credits when the invited user registers and 200 when that user upgrades. The invitation can be shared to five social destinations or copied as a link.',
        so: 'The larger reward lands at upgrade. It is a useful template for weighting incentives toward downstream value.',
        prov: 'observed',
      },
      {
        claim: 'Runway and Revid use rewards to support activation and retention.',
        evidence:
          'Runway quests reward actions such as returning after 24 hours, trying image-to-video, using an app and saving a workflow. Revid’s onboarding checklist rewards creating, repurposing, publishing, automating and sharing.',
        so: 'These systems give users reasons to explore more capabilities and return to the product. Vivideo can use similar rewards to teach valuable workflows, not just distribute free credits.',
        prov: 'observed',
      },
    ],
  },
  {
    group: 'What follows for Vivideo',
    items: [
      {
        claim: 'Vivideo’s clearest opportunity is to make missed requirements easy to repair.',
        evidence:
          'The tested build exposed no post-generation correction layer, while some outputs missed explicit requirements and some cost estimates differed from the final charge. A single problem can therefore push the user toward another full generation.',
        so: 'Keep the approved plan visible and let users repair a scene, script, caption, voice or duration without restarting the entire video.',
        prov: 'interpretation',
      },
    ],
  },
];

const recommendations = [
  {
    title: 'Make approval a binding Generation Contract',
    detail:
      'Show prompt, interpreted brief, model, maximum credit charge, duration tolerance and critical restrictions before charging. Never exceed the ceiling or switch models without re-approval; restore credits automatically on technical failure.',
    outcome: 'Trust and predictable economics',
  },
  {
    title: 'Treat every generated video as an editable draft',
    detail:
      'Replace one scene, edit the script, fix captions, swap the voice — with the cost shown before regenerating. Not a timeline editor; a correction layer.',
    outcome: 'Recoverability and higher export conversion',
  },
  {
    title: 'Make model routing intelligent but visible',
    detail:
      'Four understandable modes, each showing model, credit ceiling, expected time and known limits. Lock the approved model; require consent before any fallback.',
    outcome: 'Better quality per credit without confusing users',
  },
  {
    title: 'Package outcomes and preserve creator memory',
    detail:
      '10–15 curated recipes instead of a catalogue of near-identical tools. Persist brand kit, characters, voices and CTAs so the agent asks only what changed.',
    outcome: 'Faster activation and differentiated repeat use',
  },
  {
    title: 'Turn sharing into a measurable distribution engine',
    detail:
      'Two-sided referral paid on activation and upgrade, publishing rewards tied to downstream value, quests that teach high-value behaviour. After the core experience is reliable.',
    outcome: 'Compounding acquisition and retention',
  },
];

let n = 0;
---

<Base title="Executive summary — Vivideo competitor analysis">
  <article class="shell doc">
    <header class="doc-head">
      <p class="eyebrow">Executive summary · 25 July – 1 August 2026</p>
      <h1>
        Six AI video products. One prompt set.<br />
        <em>Control around the model is the opportunity.</em>
      </h1>
      <p class="stand prose">
        Each product produced at least one credible first run. The more durable
        differences appeared around generation: how the product plans and
        prices the work, routes the model, helps users correct a draft, remembers
        creator context and turns publishing into repeat use or acquisition.
      </p>
    </header>

    <section class="hero" aria-labelledby="gap">
      <h2 id="gap" class="hero-title">The controllable creation opportunity</h2>
      <p class="hero-note">
        Duration drift remains documented in the benchmark tables. Here it sits
        where it belongs: one signal inside a larger product-control problem.
      </p>
      <ol class="control-chain">
        <li><span class="num">01</span><strong>Plan</strong><p>Make cost, model, limits and expected output explicit.</p></li>
        <li><span class="num">02</span><strong>Generate</strong><p>Keep routing, prompt and settings visible.</p></li>
        <li><span class="num">03</span><strong>Correct</strong><p>Fix one scene or attribute without paying to restart.</p></li>
        <li><span class="num">04</span><strong>Publish</strong><p>Connect sharing to creator memory and measurable loops.</p></li>
      </ol>
    </section>

    <section aria-labelledby="nine">
      <h2 id="nine" class="sec-title">
        <span class="eyebrow">Nine things to know</span>
      </h2>

      <div class="findings">
        {
          findings.map((group) => (
            <section class="group">
              <h3 class="group-title">{group.group}</h3>
              <ol class="items" start={n + 1}>
                {group.items.map((f) => {
                  n += 1;
                  return (
                    <li class="item">
                      <p class="item-claim">
                        <span class="item-n num">{String(n).padStart(2, '0')}</span>
                        {f.claim}
                      </p>
                      <p class="item-ev">
                        {f.evidence}
                        <span class="prov" data-kind={f.prov}>
                          {f.prov === 'observed'
                            ? 'observed'
                            : f.prov === 'claim'
                              ? 'review claim'
                              : 'interpretation'}
                        </span>
                      </p>
                      <p class="item-so">{f.so}</p>
                    </li>
                  );
                })}
              </ol>
            </section>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="recs">
      <h2 id="recs" class="sec-title">
        <span class="eyebrow">Five recommendations, in order</span>
      </h2>
      <ol class="recs">
        {
          recommendations.map((r, i) => (
            <li class="rec">
              <span class="rec-n num">{i + 1}</span>
              <div>
                <h3 class="rec-title">{r.title}</h3>
                <p class="rec-detail">{r.detail}</p>
                <p class="rec-out">
                  <span class="eyebrow">Outcome</span> {r.outcome}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="rec-seq">
        The first three repair the core product. The last two scale it. Running
        them in the other order amplifies the complaints the first three fix.
      </p>
    </section>

    <footer class="caveat">
      <h2 class="eyebrow">How to read this</h2>
      <div class="caveat-grid">
        <p>
          <strong>One run per product and workflow.</strong> Directional
          case-study evidence, not a statistical ranking. Where a product ran an
          agent workflow and another ran manual generation, they are not
          comparable on output quality alone.
        </p>
        <p>
          <strong>Three kinds of claim.</strong> <span class="prov" data-kind="observed">observed</span> is
          first-hand and recorded. <span class="prov" data-kind="claim">review claim</span> is
          a user allegation, not verified fact. <span class="prov" data-kind="interpretation">interpretation</span> is
          our strategic reading.
        </p>
        <p>
          <strong>Evidence is linked, not asserted.</strong> Benchmark outputs,
          durations, models and first-run notes are on the{' '}
          <a href={route('benchmarks')}>benchmarks</a> page; pricing and
          cancellation friction on <a href={route('pricing')}>pricing</a>;
          coded review samples on <a href={route('reviews')}>reviews</a>.
        </p>
      </div>
    </footer>
  </article>
</Base>

<style>
  /* A document column, not a wide app shell. Content fills the measure
     instead of stranding a dead right margin. */
  .doc {
    max-width: 52rem;
  }

  .doc-head {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1.6rem;
    margin-bottom: 2rem;
  }
  .doc-head h1 {
    margin: 0.5rem 0 0.9rem;
  }
  .doc-head h1 em {
    font-style: normal;
    color: var(--subject);
  }
  .stand {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-mid);
    margin: 0;
    max-width: 42rem;
  }

  /* ---- Hero: the signature ---- */
  .hero {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--subject);
    padding: 1.5rem clamp(1rem, 3vw, 2rem);
    margin-bottom: 2.75rem;
  }
  .hero-title {
    font-size: var(--step-1);
    margin: 0;
  }
  .hero-title span {
    color: var(--ink-soft);
    font-weight: 600;
  }
  .hero-note {
    margin: 0.3rem 0 1.3rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .control-chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .control-chain li {
    padding: 0.8rem 0.75rem 0 0;
  }
  .control-chain li + li {
    border-left: 1px solid var(--rule);
    padding-left: 0.75rem;
  }
  .control-chain span,
  .control-chain strong {
    display: block;
  }
  .control-chain span {
    font-size: 0.65rem;
    color: var(--subject);
  }
  .control-chain strong {
    margin-top: 0.15rem;
    font-family: var(--display);
    font-size: 0.9rem;
  }
  .control-chain p {
    margin: 0.2rem 0 0;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  @media (max-width: 42rem) {
    .control-chain {
      grid-template-columns: 1fr 1fr;
    }
    .control-chain li:nth-child(3) {
      border-left: 0;
    }
    .control-chain li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  .sec-title {
    margin: 0 0 1.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  /* ---- Findings ---- */
  .findings {
    display: grid;
    gap: 1.6rem;
  }
  .group-title {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--subject);
    margin: 0 0 0.8rem;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
  }
  .item {
    padding-left: 2.6rem;
    position: relative;
  }
  .item-n {
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: 0.78rem;
    color: var(--rule-strong);
    font-weight: 600;
  }
  .item-claim {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.22;
    letter-spacing: -0.015em;
    margin: 0 0 0.35rem;
    text-wrap: balance;
  }
  .item-ev {
    margin: 0 0 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-mid);
  }
  .item-ev .prov {
    margin-left: 0.4rem;
    vertical-align: 1px;
  }
  .item-so {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
    border-left: 2px solid var(--rule);
    padding-left: 0.75rem;
  }

  /* ---- Recommendations ---- */
  .recs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .rec {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.4rem;
    align-items: start;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .rec:last-child {
    border-bottom: 0;
  }
  .rec-n {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--subject);
    line-height: 1.2;
  }
  .rec-title {
    font-size: var(--step-1);
    margin: 0 0 0.25rem;
  }
  .rec-detail {
    margin: 0 0 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-mid);
  }
  .rec-out {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .rec-out .eyebrow {
    margin-right: 0.4rem;
  }
  .rec-seq {
    margin: 1.2rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-mid);
    border-left: 3px solid var(--subject);
    padding-left: 0.85rem;
    max-width: 42rem;
  }

  section + section {
    margin-top: 2.75rem;
  }

  /* ---- Caveat ---- */
  .caveat {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
  }
  .caveat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 1.75rem;
    margin-top: 0.7rem;
  }
  .caveat-grid p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .caveat-grid strong {
    color: var(--ink);
    font-weight: 600;
  }
  .caveat-grid .prov {
    font-size: 0.58rem;
  }

  /* ============================================================
     Print: one A4 page. The brief asks for a one-page summary,
     so the page must actually be one page.
     ============================================================ */
  @media print {
    @page {
      size: A4;
      margin: 8mm 9mm;
    }
    :global(body) {
      background: #fff;
      font-size: 6.6pt;
      line-height: 1.3;
    }
    .doc {
      max-width: none;
      padding: 0;
    }
    .doc-head {
      padding-bottom: 5pt;
      margin-bottom: 7pt;
      border-bottom-width: 1.2pt;
    }
    .doc-head h1 {
      font-size: 14.5pt;
      line-height: 1.02;
      margin: 3pt 0 4pt;
    }
    .doc-head h1 br {
      display: none;
    }
    .stand {
      font-size: 6.9pt;
      line-height: 1.28;
      max-width: none;
    }
    .eyebrow {
      font-size: 5.4pt;
    }

    .hero {
      padding: 6pt 8pt;
      margin-bottom: 8pt;
      border-left-width: 2pt;
      break-inside: avoid;
    }
    .hero-title {
      font-size: 8.5pt;
    }
    .hero-note {
      font-size: 6pt;
      margin-bottom: 5pt;
    }
    .control-chain {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0 8pt;
      max-width: none;
    }
    .control-chain li {
      padding: 3pt 3pt 0 0;
    }
    .control-chain li + li {
      padding-left: 4pt;
    }
    .control-chain span {
      font-size: 5pt;
    }
    .control-chain strong {
      font-size: 6.5pt;
    }
    .control-chain p {
      font-size: 5.6pt;
      line-height: 1.2;
    }

    .sec-title {
      margin-bottom: 5pt;
      padding-bottom: 2pt;
    }
    section + section {
      margin-top: 8pt;
    }

    /* Findings run in two columns to fit the page. */
    .findings {
      column-count: 3;
      column-gap: 9pt;
      gap: 0;
      display: block;
    }
    .group {
      break-inside: avoid;
      margin-bottom: 6pt;
    }
    .group-title {
      font-size: 5.6pt;
      margin-bottom: 3pt;
    }
    .items {
      gap: 4.5pt;
      display: block;
    }
    .item {
      break-inside: avoid;
      padding-left: 12pt;
      margin-bottom: 3.6pt;
    }
    .item-n {
      font-size: 6pt;
    }
    .item-claim {
      font-size: 7.6pt;
      line-height: 1.12;
      margin-bottom: 1.6pt;
    }
    .item-ev,
    .item-so {
      font-size: 6.3pt;
      line-height: 1.3;
      max-width: none;
    }
    .item-so {
      padding-left: 4pt;
      border-left-width: 1pt;
    }
    .prov {
      font-size: 5pt;
      padding: 0 2pt;
    }

    .recs {
      display: block;
      column-count: 2;
      column-gap: 12pt;
      gap: 0;
    }
    .rec {
      grid-template-columns: 10pt 1fr;
      padding-bottom: 2.5pt;
      margin-bottom: 2.5pt;
      break-inside: avoid;
    }
    .rec-n {
      font-size: 8pt;
    }
    .rec-title {
      font-size: 7.6pt;
    }
    .rec-detail,
    .rec-out {
      font-size: 6.3pt;
      line-height: 1.3;
      max-width: none;
    }
    .rec-seq {
      font-size: 6.4pt;
      margin-top: 4pt;
      padding-left: 5pt;
    }

    .caveat {
      margin-top: 8pt;
      padding-top: 4pt;
      border-top-width: 1.2pt;
      break-inside: avoid;
    }
    .caveat-grid {
      gap: 4pt 10pt;
      margin-top: 3pt;
    }
    .caveat-grid p {
      font-size: 6pt;
      line-height: 1.28;
    }
  }
</style>
