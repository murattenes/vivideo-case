---
import '../styles/global.css';
import { route } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Hide site chrome — used by the printable executive summary. */
  bare?: boolean;
}

const {
  title,
  description = 'First-hand competitor product analysis for Vivideo: six AI video platforms, five fixed benchmark prompts, paid accounts, recorded sessions.',
  bare = false,
} = Astro.props;

const nav = [
  { label: 'Overview', href: '' },
  { label: 'Summary', href: 'executive-summary' },
  { label: 'Benchmarks', href: 'benchmarks' },
  { label: 'Competitors', href: 'competitors' },
  { label: 'Pricing', href: 'pricing' },
  { label: 'Reviews', href: 'reviews' },
  { label: 'Distribution', href: 'distribution' },
  { label: 'Strategy', href: 'strategy' },
  { label: 'Freshness', href: 'freshness' },
];

const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    {
      !bare && (
        <header class="chrome">
          <div class="shell chrome-inner">
            <a class="mark" href={route('')}>
              <span class="mark-name">Vivideo</span>
              <span class="mark-rest">competitor analysis</span>
            </a>
            <nav aria-label="Sections">
              <ul>
                {nav.map(({ label, href }) => {
                  const target = route(href);
                  return (
                    <li>
                      <a href={target} aria-current={here === target ? 'page' : undefined}>
                        {label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          </div>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <footer class="chrome foot">
          <div class="shell">
            <p>
              Hands-on testing 25 July – 1 August 2026. Six products, five fixed
              prompts, paid accounts, recorded sessions.{' '}
              <strong>One run per product and workflow</strong> — directional
              evidence, not a statistical ranking.
            </p>
          </div>
        </footer>
      )
    }

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
        z-index: 20;
        background: var(--paper-raised);
        padding: 0.5rem 0.8rem;
        border: 1px solid var(--ink);
      }

      .chrome {
        border-bottom: 1px solid var(--rule);
        background: var(--paper-raised);
      }

      .chrome-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 2rem;
        align-items: baseline;
        justify-content: space-between;
        padding-block: 0.9rem;
      }

      .mark {
        text-decoration: none;
        display: inline-flex;
        align-items: baseline;
        gap: 0.45rem;
        font-family: var(--display);
        font-size: 0.98rem;
        letter-spacing: -0.015em;
      }
      .mark-name {
        font-weight: 800;
        color: var(--subject);
      }
      .mark-rest {
        font-weight: 600;
        color: var(--ink-soft);
      }

      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.1rem 1.05rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav a {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-soft);
        text-decoration: none;
        padding-block: 0.2rem;
        border-bottom: 2px solid transparent;
      }
      nav a:hover {
        color: var(--ink);
      }
      nav a[aria-current='page'] {
        color: var(--ink);
        border-bottom-color: var(--subject);
      }

      main {
        padding-block: clamp(2rem, 5vw, 3.5rem) 4rem;
      }

      .foot {
        border-bottom: 0;
        border-top: 1px solid var(--rule);
        padding-block: 1.4rem;
      }
      .foot p {
        margin: 0;
        max-width: 46rem;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }
      .foot strong {
        color: var(--ink);
        font-weight: 600;
      }

      @media print {
        .chrome,
        .skip {
          display: none !important;
        }
        main {
          padding: 0 !important;
        }
      }
    </style>
  </body>
</html>
