---
import Base from '../layouts/Base.astro';
import Divergence from '../components/Divergence.astro';
import { route } from '../lib/url';

const findings = [
  {
    group: 'What is true of the market',
    items: [
      {
        claim: 'The same prompt never tested the same thing.',
        evidence:
          'One fixed prompt set, six different orchestration decisions: InVideo auto-selected Seedance 2.0, Pollo used Pollo 2.5, Runway’s agent capped itself at 10s on Seedance 2.0 Mini, Revid assembled four separate shots.',
        so: 'Model quality and product quality are different axes — and buyers cannot separate them either. Competing on “best model” competes on something no user perceives independently of your orchestration.',
        prov: 'observed',
      },
      {
        claim: 'Credit opacity is the category’s wound, not a Vivideo bug.',
        evidence:
          'It recurs in reviews of all six: HeyGen credits spent on an unfinished video, Runway credits not restored after two generations stuck at 0%, Pollo subscribers still buying extra credits, InVideo’s agent regenerating clips without approval, Revid’s displayed and charged credits disagreeing.',
        so: 'No one owns “you only pay for output you accept.” The position is unclaimed.',
        prov: 'claim',
      },
      {
        claim: 'The paywall consistently lands after the effort, not before it.',
        evidence:
          'Vivideo reviewers report the advertised free video required payment to view. InVideo’s free allowance ran out after agent setup but before generation. Runway’s free tier gave image access but not the expected video access. Pollo’s free export carries a watermark.',
        so: 'Users meet the wall at maximum sunk cost. That is the moment that produces refund demands and one-star reviews.',
        prov: 'claim',
      },
    ],
  },
  {
    group: 'What we found in Vivideo, first-hand',
    items: [
      {
        claim: 'Approval is not binding.',
        evidence:
          'An estimate of 9 credits charged 15. A plan approved at 12 charged 21. A plan preview of 18 seconds delivered 34. A separate 6-credit estimate charged exactly 6 — the estimates are not consistently inflated, they are unreliable.',
        so: 'The most fixable trust defect we found, and upstream of most of the complaints in Vivideo’s own reviews.',
        prov: 'observed',
      },
      {
        claim: 'Negative constraints were ignored.',
        evidence:
          'T2V-01 prohibited audio; the output added a voice reading the visual prompt aloud. I2V-01 required the mug text to change PAUSE→PLAY and the pinwheel to complete one rotation; the text never changed and the pinwheel stopped.',
        so: 'A user can rewrite a prompt to ask for more. They cannot rewrite it to ask for less. Prohibition failures have no workaround.',
        prov: 'observed',
      },
      {
        claim: 'Cancellation cannot be completed inside the product.',
        evidence:
          'The flow shows what will be lost, asks for a reason, offers 50 bonus credits — then instructs the user to email support. Pollo completed cancellation in three clicks.',
        so: 'It converts a routine churn event into a support ticket and, repeatedly, a public review.',
        prov: 'observed',
      },
    ],
  },
  {
    group: 'What is worth taking from competitors',
    items: [
      {
        claim: 'Pollo pays referrals at conversion, not at signup.',
        evidence:
          '50 credits to each side when the invited user registers, 200 to each side when that user upgrades. Shareable to six destinations.',
        so: 'The reward lands where the value is. A template for paying for activation instead of vanity registrations.',
        prov: 'observed',
      },
      {
        claim: 'Revid pays for publishing, not just for generating.',
        evidence:
          'Publishing on Revid earns 25 credits; quests reward creation and publishing; generated characters persist to the user profile for reuse.',
        so: 'It closes the loop from generation to distribution — the loop Vivideo’s share button opens and never measures.',
        prov: 'observed',
      },
    ],
  },
  {
    group: 'What follows for Vivideo',
    items: [
      {
        claim: 'The defensible layer is the contract, not the model.',
        evidence:
          'Every product tested swapped underlying models freely, and model access is rentable. Runway\u2019s home agent kept selecting Seedance even when asked to switch — its confirmation dialog offered only an Approve button. None of them make approval mean anything.',
        so: 'It is the one axis where arriving first is durable, because it is a promise about behaviour rather than a licence.',
        prov: 'interpretation',
      },
      {
        claim: 'Fix trust before buying growth.',
        evidence:
          'Vivideo’s own pricing anchors on $2/week but bills $99 once yearly, and cancellation still ends in an email. Referral and affiliate mechanics sit on top of that.',
        so: 'Acquisition scales complaints exactly as efficiently as it scales signups. Sequence matters.',
        prov: 'interpretation',
      },
    ],
  },
];

const recommendations = [
  {
    title: 'Make approval a binding Generation Contract',
    detail:
      'Show prompt, interpreted brief, scene plan, model, duration tolerance and a maximum credit charge before charging. Never exceed the ceiling without re-approval; restore credits automatically on technical failure.',
    outcome: 'Trust and predictable economics',
  },
  {
    title: 'Treat every generated video as an editable draft',
    detail:
      'Replace one scene, edit the script, fix captions, swap the voice — with the cost shown before regenerating. Not a timeline editor; a correction layer.',
    outcome: 'Recoverability and higher export conversion',
  },
  {
    title: 'Make model routing intelligent but visible',
    detail:
      'Four understandable modes, each showing model, credit ceiling, expected time and known limits. Lock the approved model; require consent before any fallback.',
    outcome: 'Better quality per credit without confusing users',
  },
  {
    title: 'Package outcomes and preserve creator memory',
    detail:
      '10–15 curated recipes instead of a catalogue of near-identical tools. Persist brand kit, characters, voices and CTAs so the agent asks only what changed.',
    outcome: 'Faster activation and differentiated repeat use',
  },
  {
    title: 'Turn sharing into a measurable distribution engine',
    detail:
      'Two-sided referral paid on activation and upgrade, publishing rewards tied to downstream value, quests that teach high-value behaviour. After the core experience is reliable.',
    outcome: 'Compounding acquisition and retention',
  },
];

let n = 0;
---

<Base title="Executive summary — Vivideo competitor analysis">
  <article class="shell doc">
    <header class="doc-head">
      <p class="eyebrow">Executive summary · 25 July – 1 August 2026</p>
      <h1>
        Six AI video products. One prompt set.<br />
        <em>The gap is the opportunity.</em>
      </h1>
      <p class="stand prose">
        Every product tested can generate a passable vertical video. Not one of
        them guarantees that the video you approved is the video you receive.
        That gap — between the plan a user accepts and the result they are
        charged for — is the most defensible position left in this category, and
        it is currently unoccupied.
      </p>
    </header>

    <!-- Hero: the thesis, drawn. Three measured instances from Vivideo's own runs. -->
    <section class="hero" aria-labelledby="gap">
      <h2 id="gap" class="hero-title">Approved <span>vs.</span> delivered</h2>
      <p class="hero-note">
        Three instances measured in Vivideo, one in HeyGen — the pattern is the
        category's; the numbers are ours. The rule marks what the user agreed to.
      </p>
      <div class="hero-bars">
        <Divergence
          label="Credit estimate shown before an auto-generation"
          approved={9}
          delivered={15}
          unit=" cr"
          source="AGENT run, 2026-07-25 · same run: 15s requested, 21s delivered"
        />
        <Divergence
          label="Agent plan approved at"
          approved={12}
          delivered={21}
          unit=" cr"
          source="AGENT run, 2026-07-25"
        />
        <Divergence
          label="Duration shown in the agent plan preview"
          approved={18}
          delivered={34}
          unit="s"
          source="AGENT-01"
        />
        <Divergence
          label="HeyGen: duration shown in its agent plan"
          approved={18}
          delivered={45}
          unit="s"
          source="HeyGen, exploratory agent run"
        />
      </div>
    </section>

    <section aria-labelledby="ten">
      <h2 id="ten" class="sec-title">
        <span class="eyebrow">Ten things to know</span>
      </h2>

      <div class="findings">
        {
          findings.map((group) => (
            <section class="group">
              <h3 class="group-title">{group.group}</h3>
              <ol class="items" start={n + 1}>
                {group.items.map((f) => {
                  n += 1;
                  return (
                    <li class="item">
                      <p class="item-claim">
                        <span class="item-n num">{String(n).padStart(2, '0')}</span>
                        {f.claim}
                      </p>
                      <p class="item-ev">
                        {f.evidence}
                        <span class="prov" data-kind={f.prov}>
                          {f.prov === 'observed'
                            ? 'observed'
                            : f.prov === 'claim'
                              ? 'review claim'
                              : 'interpretation'}
                        </span>
                      </p>
                      <p class="item-so">{f.so}</p>
                    </li>
                  );
                })}
              </ol>
            </section>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="recs">
      <h2 id="recs" class="sec-title">
        <span class="eyebrow">Five recommendations, in order</span>
      </h2>
      <ol class="recs">
        {
          recommendations.map((r, i) => (
            <li class="rec">
              <span class="rec-n num">{i + 1}</span>
              <div>
                <h3 class="rec-title">{r.title}</h3>
                <p class="rec-detail">{r.detail}</p>
                <p class="rec-out">
                  <span class="eyebrow">Outcome</span> {r.outcome}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="rec-seq">
        The first three repair the core product. The last two scale it. Running
        them in the other order amplifies the complaints the first three fix.
      </p>
    </section>

    <footer class="caveat">
      <h2 class="eyebrow">How to read this</h2>
      <div class="caveat-grid">
        <p>
          <strong>One run per product and workflow.</strong> Directional
          case-study evidence, not a statistical ranking. Where a product ran an
          agent workflow and another ran manual generation, they are not
          comparable on output quality alone.
        </p>
        <p>
          <strong>Three kinds of claim.</strong> <span class="prov" data-kind="observed">observed</span> is
          first-hand and recorded. <span class="prov" data-kind="claim">review claim</span> is
          a user allegation, not verified fact. <span class="prov" data-kind="interpretation">interpretation</span> is
          our strategic reading.
        </p>
        <p>
          <strong>Evidence is linked, not asserted.</strong> Benchmark outputs,
          durations, models and first-run notes are on the{' '}
          <a href={route('benchmarks')}>benchmarks</a> page; pricing and
          cancellation friction on <a href={route('pricing')}>pricing</a>;
          coded review samples on <a href={route('reviews')}>reviews</a>.
        </p>
      </div>
    </footer>
  </article>
</Base>

<style>
  /* A document column, not a wide app shell. Content fills the measure
     instead of stranding a dead right margin. */
  .doc {
    max-width: 52rem;
  }

  .doc-head {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1.6rem;
    margin-bottom: 2rem;
  }
  .doc-head h1 {
    margin: 0.5rem 0 0.9rem;
  }
  .doc-head h1 em {
    font-style: normal;
    color: var(--subject);
  }
  .stand {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-mid);
    margin: 0;
    max-width: 42rem;
  }

  /* ---- Hero: the signature ---- */
  .hero {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--subject);
    padding: 1.5rem clamp(1rem, 3vw, 2rem);
    margin-bottom: 2.75rem;
  }
  .hero-title {
    font-size: var(--step-1);
    margin: 0;
  }
  .hero-title span {
    color: var(--ink-soft);
    font-weight: 600;
  }
  .hero-note {
    margin: 0.3rem 0 1.3rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .hero-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 0.2rem 2.4rem;
  }

  .sec-title {
    margin: 0 0 1.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  /* ---- Findings ---- */
  .findings {
    display: grid;
    gap: 1.6rem;
  }
  .group-title {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--subject);
    margin: 0 0 0.8rem;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
  }
  .item {
    padding-left: 2.6rem;
    position: relative;
  }
  .item-n {
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: 0.78rem;
    color: var(--rule-strong);
    font-weight: 600;
  }
  .item-claim {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.22;
    letter-spacing: -0.015em;
    margin: 0 0 0.35rem;
    text-wrap: balance;
  }
  .item-ev {
    margin: 0 0 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-mid);
  }
  .item-ev .prov {
    margin-left: 0.4rem;
    vertical-align: 1px;
  }
  .item-so {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
    border-left: 2px solid var(--rule);
    padding-left: 0.75rem;
  }

  /* ---- Recommendations ---- */
  .recs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .rec {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.4rem;
    align-items: start;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .rec:last-child {
    border-bottom: 0;
  }
  .rec-n {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--subject);
    line-height: 1.2;
  }
  .rec-title {
    font-size: var(--step-1);
    margin: 0 0 0.25rem;
  }
  .rec-detail {
    margin: 0 0 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-mid);
  }
  .rec-out {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .rec-out .eyebrow {
    margin-right: 0.4rem;
  }
  .rec-seq {
    margin: 1.2rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-mid);
    border-left: 3px solid var(--subject);
    padding-left: 0.85rem;
    max-width: 42rem;
  }

  section + section {
    margin-top: 2.75rem;
  }

  /* ---- Caveat ---- */
  .caveat {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
  }
  .caveat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 1.75rem;
    margin-top: 0.7rem;
  }
  .caveat-grid p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .caveat-grid strong {
    color: var(--ink);
    font-weight: 600;
  }
  .caveat-grid .prov {
    font-size: 0.58rem;
  }

  /* ============================================================
     Print: one A4 page. The brief asks for a one-page summary,
     so the page must actually be one page.
     ============================================================ */
  @media print {
    @page {
      size: A4;
      margin: 8mm 9mm;
    }
    :global(body) {
      background: #fff;
      font-size: 6.6pt;
      line-height: 1.3;
    }
    .doc {
      max-width: none;
      padding: 0;
    }
    .doc-head {
      padding-bottom: 5pt;
      margin-bottom: 7pt;
      border-bottom-width: 1.2pt;
    }
    .doc-head h1 {
      font-size: 14.5pt;
      line-height: 1.02;
      margin: 3pt 0 4pt;
    }
    .doc-head h1 br {
      display: none;
    }
    .stand {
      font-size: 6.9pt;
      line-height: 1.28;
      max-width: none;
    }
    .eyebrow {
      font-size: 5.4pt;
    }

    .hero {
      padding: 6pt 8pt;
      margin-bottom: 8pt;
      border-left-width: 2pt;
      break-inside: avoid;
    }
    .hero-title {
      font-size: 8.5pt;
    }
    .hero-note {
      font-size: 6pt;
      margin-bottom: 5pt;
    }
    .hero-bars {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0 8pt;
      max-width: none;
    }

    .sec-title {
      margin-bottom: 5pt;
      padding-bottom: 2pt;
    }
    section + section {
      margin-top: 8pt;
    }

    /* Findings run in two columns to fit the page. */
    .findings {
      column-count: 3;
      column-gap: 9pt;
      gap: 0;
      display: block;
    }
    .group {
      break-inside: avoid;
      margin-bottom: 6pt;
    }
    .group-title {
      font-size: 5.6pt;
      margin-bottom: 3pt;
    }
    .items {
      gap: 4.5pt;
      display: block;
    }
    .item {
      break-inside: avoid;
      padding-left: 12pt;
      margin-bottom: 3.6pt;
    }
    .item-n {
      font-size: 6pt;
    }
    .item-claim {
      font-size: 7.6pt;
      line-height: 1.12;
      margin-bottom: 1.6pt;
    }
    .item-ev,
    .item-so {
      font-size: 6.3pt;
      line-height: 1.3;
      max-width: none;
    }
    .item-so {
      padding-left: 4pt;
      border-left-width: 1pt;
    }
    .prov {
      font-size: 5pt;
      padding: 0 2pt;
    }

    .recs {
      display: block;
      column-count: 2;
      column-gap: 12pt;
      gap: 0;
    }
    .rec {
      grid-template-columns: 10pt 1fr;
      padding-bottom: 2.5pt;
      margin-bottom: 2.5pt;
      break-inside: avoid;
    }
    .rec-n {
      font-size: 8pt;
    }
    .rec-title {
      font-size: 7.6pt;
    }
    .rec-detail,
    .rec-out {
      font-size: 6.3pt;
      line-height: 1.3;
      max-width: none;
    }
    .rec-seq {
      font-size: 6.4pt;
      margin-top: 4pt;
      padding-left: 5pt;
    }

    .caveat {
      margin-top: 8pt;
      padding-top: 4pt;
      border-top-width: 1.2pt;
      break-inside: avoid;
    }
    .caveat-grid {
      gap: 4pt 10pt;
      margin-top: 3pt;
    }
    .caveat-grid p {
      font-size: 6pt;
      line-height: 1.28;
    }
  }
</style>
