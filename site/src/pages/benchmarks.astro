---
import Base from '../layouts/Base.astro';
import BenchmarkCard from '../components/BenchmarkCard.astro';
import data from '../data/benchmarks.json';
import media from '../data/media-manifest.json';

const { prompts, products } = data;
const slugFor: Record<string, string> = {
  'AGENT-01': 'agent01', 'AD-01': 'ad01', 'T2V-01': 't2v01',
  'I2V-01': 'i2v01', 'AVATAR-01': 'avatar01',
};
const mediaFor = (promptId: string, productId: string) =>
  (media.items as Record<string, any>)[`${productId}-${slugFor[promptId]}`];

const productName = (id: string) => (products as Record<string, { name: string; baseline: boolean }>)[id]?.name ?? id;
const isBaseline = (id: string) => (products as Record<string, { name: string; baseline: boolean }>)[id]?.baseline ?? false;
---

<Base title="Benchmarks — Vivideo competitor analysis">
  <div class="shell">
    <header class="head">
      <p class="eyebrow">Benchmarks · five fixed prompts · six products</p>
      <h1>Same prompts, thirty first runs</h1>
      <p class="stand">
        Every product received the same five prompts and the same source assets,
        on a paid plan. All 30 first outputs were preserved, and approximately
        25 competitor sessions were screen-recorded — no retries, no
        cherry-picking.
      </p>
    </header>

    <nav class="jump" aria-label="Jump to prompt">
      {prompts.map((p) => <a class="num" href={`#${p.slug}`}>{p.id}</a>)}
    </nav>

    {
      prompts.map((prompt) => (
        <section class="prompt" id={prompt.slug} aria-labelledby={`${prompt.slug}-h`}>
          <div class="prompt-head">
            <h2 id={`${prompt.slug}-h`}>
              <span class="num prompt-id">{prompt.id}</span>
              {prompt.name}
            </h2>
            <p class="prompt-goal">{prompt.goal}</p>
          </div>

          <div class="scroll-x">
            <table>
              <thead>
                <tr>
                  <th scope="col">Product</th>
                  <th scope="col">Workflow</th>
                  <th scope="col">Model</th>
                  <th scope="col">Requested → delivered</th>
                  <th scope="col">First-run note</th>
                </tr>
              </thead>
              <tbody>
                {prompt.rows.map((r) => (
                  <tr class={isBaseline(r.product) ? 'baseline' : ''}>
                    <th scope="row" class="p-name">
                      {productName(r.product)}
                    </th>
                    <td>
                      <span class="wf" data-wf={r.workflow}>{r.workflow}</span>
                      {r.autoSelected && r.model && <span class="auto">auto</span>}
                    </td>
                    <td class="n">{r.model ?? '—'}</td>
                    <td class="n dur" data-dev={r.flag === 'duration' ? 'y' : 'n'}>
                      {r.requested} → <strong>{r.actual}</strong>
                    </td>
                    <td class="note">
                      {r.flag === 'constraint' && (
                        <span class="constraint">constraint violated</span>
                      )}
                      {r.note}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="evidence">
            <p class="evidence-note">
              <span class="eyebrow">Evidence</span> First-run outputs. Each card opens the
              full-resolution vertical video in Google Drive; where a full
              session recording of the run exists, it is linked beneath.
            </p>
            <div class="cards">
              {prompt.rows.map((r) => {
                const m = mediaFor(prompt.id, r.product);
                return (
                  <BenchmarkCard
                    id={`${r.product}-${slugFor[prompt.id]}`}
                    productName={productName(r.product)}
                    baseline={isBaseline(r.product)}
                    driveId={m?.driveId ?? null}
                    poster={m?.poster ?? ''}
                    durationSec={m?.durationSec ?? 0}
                    sessionRecordingId={m?.sessionRecordingId ?? null}
                  />
                );
              })}
            </div>
          </div>
        </section>
      ))
    }

    <section class="reading" aria-labelledby="reading-h">
      <h2 id="reading-h">What the thirty runs add up to</h2>
      <ul>
        <li>
          <strong>I2V-01 was the hardest benchmark in this test set.</strong>
          Every output rotated the red pinwheel more than the requested
          approximately one full clockwise turn. InVideo preserved the source
          scene best; other runs also introduced object or temporal instability.
        </li>
        <li>
          <strong>Hard constraints created the most consequential failures.</strong>
          Vivideo added narration to a no-audio prompt, Revid left the boat
          stationary, and the I2V rotation constraint failed everywhere. These
          are correction problems, not small quality differences.
        </li>
        <li>
          <strong>Duration drift is a secondary predictability signal.</strong>
          The largest misses appeared when an agent planned or auto-selected
          the workflow; manually selected durations were delivered more
          consistently. The strategic issue is control over the plan, not video
          length by itself.
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .head {
    max-width: 46rem;
  }
  .head h1 {
    margin: 0.6rem 0 0.8rem;
  }
  .stand {
    font-size: var(--step-1);
    color: var(--ink-mid);
    margin: 0;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.6rem 0 0.4rem;
  }
  .jump a {
    font-size: 0.72rem;
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    padding: 0.25rem 0.6rem;
    color: var(--ink-soft);
  }
  .jump a:hover {
    border-color: var(--subject);
    color: var(--subject);
  }

  .prompt {
    margin-top: 2.6rem;
    scroll-margin-top: 1rem;
  }
  .prompt-head h2 {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .prompt-id {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--subject);
    border: 1px solid currentColor;
    padding: 0.15rem 0.5rem;
  }
  .prompt-goal {
    margin: 0.4rem 0 1rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
    max-width: 46rem;
  }

  tr.baseline th,
  tr.baseline td {
    background: var(--subject-wash);
  }
  .p-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
  }
  tr.baseline .p-name {
    color: var(--subject);
  }

  .wf {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.12em 0.4em;
    border: 1px solid var(--rule-strong);
  }
  .wf[data-wf='agent'] {
    border-color: var(--ink);
    color: var(--ink);
  }
  .wf[data-wf='manual'] {
    color: var(--ink-soft);
  }
  .auto {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--ink-soft);
    margin-left: 0.3rem;
  }

  .dur {
    white-space: nowrap;
  }
  .dur strong {
    font-weight: 600;
  }
  .dur[data-dev='y'] strong {
    color: var(--diverge);
    background: var(--diverge-wash);
    padding: 0.05em 0.3em;
  }

  .note {
    min-width: 18rem;
    color: var(--ink-mid);
  }
  .constraint {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--diverge);
    border: 1px solid var(--diverge);
    padding: 0.1em 0.4em;
    margin-right: 0.45rem;
    vertical-align: 1px;
    white-space: nowrap;
  }

  .evidence {
    margin-top: 0.9rem;
  }
  .evidence-note {
    margin: 0 0 0.6rem;
    font-size: 0.76rem;
    color: var(--ink-soft);
  }
  .evidence-note .eyebrow {
    margin-right: 0.45rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.7rem;
    max-width: 74rem;
  }
  @media (min-width: 60rem) {
    .cards {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .reading {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 2px solid var(--ink);
    max-width: 52rem;
  }
  .reading ul {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }
  .reading li {
    font-size: 0.9rem;
    color: var(--ink-mid);
    line-height: 1.55;
    padding-left: 0.9rem;
    border-left: 2px solid var(--rule);
  }
  .reading strong {
    color: var(--ink);
  }
</style>
